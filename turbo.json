{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["AA_LIVE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "env": ["AA_LIVE"],
      "passThroughEnv": ["AA_APIKEY", "AA_CACHE_DIR"]
    }
  }
}
