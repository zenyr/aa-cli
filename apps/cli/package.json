{
  "name": "@zenyr/aa-cli",
  "version": "0.0.0",
  "description": "Agent-friendly CLI for the Artificial Analysis Data API",
  "license": "MIT",
  "author": "zenyr",
  "bin": {
    "aa": "./dist/aa.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --target=bun --outfile=dist/aa.js",
    "build:bin": "bun build ./src/main.ts --compile --outfile=dist/aa",
    "dev": "AA_CACHE_DIR=\"${AA_CACHE_DIR:-$(../../scripts/cache-dir.sh)}\" bun run ./src/main.ts",
    "typecheck": "tsc -p .",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@aa/adapter-aa-http": "workspace:*",
    "@aa/adapter-cache": "workspace:*",
    "@aa/adapter-cli": "workspace:*",
    "@aa/application": "workspace:*",
    "@aa/domain": "workspace:*",
    "@effect/platform": "^0.97.2",
    "@effect/platform-bun": "^0.91.2",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@aa/tsconfig": "workspace:*"
  }
}
